# Copy to .env for local development. Never commit the real .env.

# SQLite file. Three slashes for an absolute path: sqlite:///var/lib/app/app.db
DATABASE_URL=sqlite://data/app.db

# Address the HTTP API listens on. Use 0.0.0.0 inside Docker.
BIND_ADDR=0.0.0.0:8080

# How long a login stays valid.
SESSION_TTL_HOURS=12

# Creates the first admin only when the users table is empty. That admin must
# change this password on first login; remove these once the admin exists.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# Log level: error, warn, info, debug, trace
RUST_LOG=info
